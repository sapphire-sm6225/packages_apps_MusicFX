<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="32dp" />
            <corners android:radius="16dp" />
            <solid android:color="@color/switch_track_on" />
            <padding android:left="4dp" android:right="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="32dp" />
            <corners android:radius="16dp" />
            <solid android:color="@color/switch_track_off" />
            <stroke android:width="2dp" android:color="@color/switch_outline" />
            <padding android:left="4dp" android:right="4dp" />
        </shape>
    </item>
</selector>
