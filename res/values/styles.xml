<resources>
    <!-- Edge-to-edge is already on; keep the status/navigation bar icons readable in light mode -->
    <style name="Theme.MusicFX" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowLightStatusBar">@bool/theme_is_light</item>
        <item name="android:windowLightNavigationBar">@bool/theme_is_light</item>
        <item name="android:switchStyle">@style/Widget.MusicFX.Switch</item>
    </style>

    <!-- Material 3 look for the on/off switch, resources only (no Java change) -->
    <style name="Widget.MusicFX.Switch" parent="">
        <!-- no parent, so clickable/focusable (normally inherited from Widget.Button) must be set here -->
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:showText">false</item>
        <item name="android:switchMinWidth">56dp</item>
    </style>
</resources>
